.hero__name { background-image: ; background-position-x: ; background-posit=
ion-y: ; background-size: ; background-repeat: ; background-attachment: ; b=
ackground-origin: ; background-color: ; background-clip: text; color: trans=
parent; }

.hero__subtitle { font-size: 1.1rem; color: var(--muted); max-width: 58ch; =
}

.hero__cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; }

.hero__meta { display: flex; gap: 14px; margin-top: 14px; color: var(--mute=
d); flex-wrap: wrap; }

.metaItem { display: inline-flex; gap: 8px; align-items: center; }

.card { border: 1px solid var(--border); border-radius: var(--radius); back=
ground: linear-gradient(180deg, var(--card), var(--card2)); box-shadow: var=
(--shadow); padding: 18px; }

.hero__card { position: relative; overflow: hidden; padding: 10px; border-r=
adius: 20px; }

.hero__card::before { content: ""; position: absolute; inset: -2px; backgro=
und: radial-gradient(500px 300px at 20% 0%, rgba(126, 73, 73, 0.227), trans=
parent 60%); pointer-events: none; }

.profile { display: flex; gap: 14px; align-items: center; position: relativ=
e; }

.avatar { width: 66px; height: 66px; border-radius: 18px; overflow: hidden;=
 border: 1px solid var(--border); background: rgba(115, 63, 63, 0.06); }

.profile__name { font-size: 1.2rem; }

.profile__role { margin: 2px 0px 6px; color: var(--muted); }

.profile__links { display: flex; gap: 10px; flex-wrap: wrap; }

.profile__links a { color: var(--muted); font-weight: 600; border-bottom: 1=
px dashed transparent; }

.profile__links a:hover { color: var(--text); border-bottom-color: var(--bo=
rder); }

.stats { margin-top: 14px; display: grid; grid-template-columns: repeat(3, =
1fr); gap: 10px; position: relative; }

.stat { border: 1px solid var(--border); border-radius: 16px; background: v=
ar(--card2); padding: 10px 12px; }

.stat__num { font-weight: 800; font-size: 1.25rem; }

.stat__label { color: var(--muted); font-size: 0.95rem; }

.note { margin-top: 14px; color: var(--muted); position: relative; }

.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-t=
op: 14px; }

.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }

.list { margin: 10px 0px 0px; padding-left: 18px; color: var(--muted); }

.list li { margin: 7px 0px; }

.chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0px 18px; =
}

.chip { padding: 7px 12px; border: 1px solid var(--border); border-radius: =
999px; background: var(--card2); color: var(--muted); font-weight: 600; }

.project__thumb { border-radius: 16px; overflow: hidden; border: 1px solid =
var(--border); margin-bottom: 10px; background: rgba(114, 74, 74, 0.184); }

.project__tags { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0px=
; }

.tag { font-size: 0.88rem; padding: 4px 10px; border-radius: 999px; border:=
