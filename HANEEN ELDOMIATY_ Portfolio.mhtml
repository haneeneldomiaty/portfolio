.section--alt { background: linear-gradient(transparent, rgba(93, 62, 62, 0=
.32), transparent); }

.section__head { display: flex; gap: 14px; align-items: baseline; justify-c=
ontent: space-between; flex-wrap: wrap; margin-bottom: 18px; }

